// Static mapping test on Q2's digit, reported to show a complete 8.
#include "define.h"
#include "lcd.h"
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

static void blank_digits(void) {
    LED_7CONTROL = 0;
    LED_7DATA = 0;
}
static void show_pattern(uint8_t pattern) {
    LED_7DATA = pattern;
    _delay_us(10);
    LED_7CONTROL = 0x04; // Only digit-select Q2, not the segment bit under test.
    _delay_ms(4000);
}
static void print_hex(uint8_t value) {
    const char hex[] = "0123456789ABCDEF";
    lcd_send_data(hex[value >> 4]);
    lcd_send_data(hex[value & 0x0F]);
}
int main(void) {
    cli();
    MCUCR |= (1 << SRE);
    blank_digits();
    lcd_init();
    lcd_set_cursor(0, 0);
    lcd_send_string("7SEG Q2 MAP TEST");
    while (1) {
        blank_digits();
        lcd_set_cursor(1, 0);
        lcd_send_string("BASELINE DATA: FE   ");
        lcd_set_cursor(2, 0);
        lcd_send_string("Q2 DIGIT ONLY       ");
        lcd_set_cursor(3, 0);
        lcd_send_string("EXPECT 8, DP OFF    ");
        show_pattern(0xFE);
        for (uint8_t bit = 0; bit < 8; bit++) {
            blank_digits();
            uint8_t mask = (1 << bit);
            lcd_set_cursor(1, 0);
            lcd_send_string("BIT: ");
            lcd_send_data('0' + bit);
            lcd_send_string(" MASK: ");
            print_hex(mask);
            lcd_send_string("     ");
            lcd_set_cursor(2, 0);
            lcd_send_string("Q2 DIGIT ONLY       ");
            lcd_set_cursor(3, 0);
            lcd_send_string("RECORD SEGMENT LIT  ");
            show_pattern(mask);
        }
    }
}
