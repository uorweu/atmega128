#include "define.h"
#include "lcd.h"
#include "buttons.h"
#include "menu.h"
#include "clock.h"

#include <avr/io.h> 
#include <avr/interrupt.h>
#include <util/atomic.h>
#include <util/delay.h>

// Internal RAM accesses here cannot pulse ALE: XMEM stays disabled.
static volatile uint16_t ticks;
ISR(TIMER1_COMPA_vect) {
  ticks++;
}

int main(void) {
  io_bus_init(); // Slow GPIO bus: no automatic ALE on internal accesses.

  lcd_init();
  // Distinct startup message identifies this diagnostic firmware.
  lcd_set_cursor(0, 0);
  lcd_send_string("GPIO BUS TEST");
  _delay_ms(1000);
  clock_init();
  menu_init();

  // 16 MHz / 64 / 2500 = 100 Hz: button/menu tick every 10 ms.
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1 = 0;
  OCR1A = (F_CPU / 64UL / 100UL) - 1;
  TIFR = (1 << OCF1A);
  TIMSK |= (1 << OCIE1A);
  TCCR1B = (1 << WGM12) | (1 << CS11) | (1 << CS10);
  sei();

  uint16_t processed = 0;
  uint8_t clock_ticks = 0;
  while (1) {
    uint16_t now;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
      now = ticks;
    }
    if (processed == now) continue;
    processed++;
    if (++clock_ticks == 100) {
      clock_ticks = 0;
      clock_tick_1s();
    }
    button_update(); // CSEL0: bits are active HIGH after the 74HC14.
    menu_update();
  }

}
