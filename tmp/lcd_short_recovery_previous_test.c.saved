// Show 0..9 on one physical digit; no multiplexing or timer interrupts.
#include "define.h"
#include "lcd.h"
#include "buttons.h"
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

static void show_number(uint8_t digit, uint8_t number, uint8_t paused) {
    const char hex[] = "0123456789ABCDEF";
    uint8_t pattern = SEGMENT_MAP[number];
    LED_7CONTROL = 0;
    LED_7DATA = 0;
    lcd_set_cursor(0, 0);
    lcd_send_string("0-9 DIGIT TEST      ");
    lcd_set_cursor(1, 0);
    lcd_send_string("LED Q");
    lcd_send_data('0' + digit);
    lcd_send_string(" EXPECT: ");
    lcd_send_data('0' + number);
    lcd_send_string("    ");
    lcd_set_cursor(2, 0);
    lcd_send_string("DATA: ");
    lcd_send_data(hex[pattern >> 4]);
    lcd_send_data(hex[pattern & 0x0F]);
    lcd_send_string(" DP OFF     ");
    lcd_set_cursor(3, 0);
    lcd_send_string(paused ? "PAUSED L/R:NUMBER   " : "U/D:LED GO:PAUSE    ");
    LED_7DATA = pattern;
    _delay_us(10);
    LED_7CONTROL = (1 << digit);
}

int main(void) {
    cli();
    MCUCR |= (1 << SRE);
    LED_7CONTROL = 0;
    LED_7DATA = 0;
    lcd_init();
    uint8_t digit = 0, number = 0, paused = 0;
    uint16_t elapsed = 0;
    show_number(digit, number, paused);
    while (1) {
        button_update(); // U4 OE must connect to RD_L, not GND.
        uint8_t pressed = button_pressed();
        uint8_t changed = 1;
        if (pressed & BTN_BIT_UP) {
            digit = (digit == 5) ? 0 : digit + 1;
        } else if (pressed & BTN_BIT_DOWN) {
            digit = (digit == 0) ? 5 : digit - 1;
        } else if (pressed & BTN_BIT_GO) {
            paused = !paused;
        } else if (pressed & BTN_BIT_RIGHT) {
            number = (number == 9) ? 0 : number + 1;
            paused = 1;
        } else if (pressed & BTN_BIT_LEFT) {
            number = (number == 0) ? 9 : number - 1;
            paused = 1;
        } else {
            changed = 0;
        }
        if (changed) {
            elapsed = 0;
            show_number(digit, number, paused);
        }
        _delay_ms(10);
        if (!paused && ++elapsed >= 200) { // Approximately two seconds per number.
            elapsed = 0;
            number = (number == 9) ? 0 : number + 1;
            show_number(digit, number, paused);
        }
    }
}
